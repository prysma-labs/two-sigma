# One copy of this file on each VM, as agent.env mode 600.
# AGENT_ID is quant, onchain, fundamental, hyperliquid, or market.
AGENT_ID=quant
PORT=8000
HOST=127.0.0.1
AGENT_SHARED_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional. Point at an exe.dev LLM integration that stores the OpenRouter key
# at the edge, and set OPENROUTER_API_KEY=exe-llm-integration.
# OPENROUTER_BASE_URL=https://openrouter.int.exe.xyz/api/v1

# Solana auditor (AGENT_ID=onchain) and MetaDAO investigator (AGENT_ID=quant).
# The Helius MCP reads chain data.
# HELIUS_API_KEY=
# HELIUS_NETWORK=mainnet

# Equity researcher (AGENT_ID=fundamental). Each Financial Datasets call pays
# USDC on Base over x402. No API key. A 0x-prefixed hex private key.
# X402_PRIVATE_KEY=

# Event log only. The conversation stays in SQLite.
# Leave unset to skip the log.
SUPABASE_URL=https://pibrkfklpyqjvzfetbbi.supabase.co
SUPABASE_SECRET_KEY=
